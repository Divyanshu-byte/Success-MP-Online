# ==============================================================
# Success MP Online — Frontend Environment Variables
# ==============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git. It is listed in .gitignore.
#
# IMPORTANT: Only VITE_* variables are exposed to the browser bundle.
# NEVER put any secret key here (JWT secrets, API keys, DB passwords).
# ==============================================================

# ── BACKEND API ───────────────────────────────────────────────
# Local development:
VITE_API_URL=http://localhost:3000/api/v1

# Production (Railway / Render / VPS):
# VITE_API_URL=https://your-backend-railway-domain.railway.app/api/v1
